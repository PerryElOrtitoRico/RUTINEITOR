<?xml version="1.0" encoding="utf-8"?>
<!-- Recuadro de un ejercicio: encabezado (nombre + reps), tabla Zona | Planilla | Entrenado, sensación y notas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/recuadro"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/celda_encabezado"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/nombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/texto"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/secundario"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TableLayout
            android:id="@+id/tabla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/borde"
            android:paddingStart="1dp"
            android:paddingTop="1dp"
            android:shrinkColumns="2"
            android:stretchColumns="2" />

        <TextView
            style="@style/Rutina.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensación" />

        <Spinner
            android:id="@+id/sensacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/Rutina.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notas" />

        <EditText
            android:id="@+id/nota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="500"
            android:minLines="2" />
    </LinearLayout>
</LinearLayout>

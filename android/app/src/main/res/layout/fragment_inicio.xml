<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/sin_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargá un plan en la pestaña Planes"
            android:textColor="@color/texto"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/con_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Rutina.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Plan" />

            <Spinner
                android:id="@+id/elegir_plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Rutina.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Microciclo" />

                    <Spinner
                        android:id="@+id/elegir_micro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Rutina.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Día" />

                    <Spinner
                        android:id="@+id/elegir_dia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/abrir_sesion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Abrir sesión" />

            <TextView
                android:id="@+id/titulo_tabla"
                style="@style/Rutina.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp" />

            <TableLayout
                android:id="@+id/tabla_sesiones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/borde"
                android:paddingStart="1dp"
                android:paddingTop="1dp"
                android:stretchColumns="*" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

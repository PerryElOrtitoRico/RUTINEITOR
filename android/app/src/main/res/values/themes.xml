<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema rústico: grises, bordes de 1 dp, esquinas de 3 dp, botones planos. El oscuro sale de values-night/colors.xml. -->
    <style name="Theme.Rutina" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/foco</item>
        <item name="colorPrimaryVariant">@color/foco</item>
        <item name="colorOnPrimary">@color/campo</item>
        <item name="colorSecondary">@color/foco</item>
        <item name="colorOnSecondary">@color/campo</item>
        <item name="colorSurface">@color/campo</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:textColorPrimary">@color/texto</item>
        <item name="android:textColorSecondary">@color/secundario</item>
        <item name="android:textColorHint">@color/secundario</item>
        <item name="colorControlNormal">@color/secundario</item>
        <item name="colorControlActivated">@color/foco</item>
        <item name="colorControlHighlight">@color/borde</item>
        <item name="android:statusBarColor">@color/barra</item>
        <item name="android:navigationBarColor">@color/barra</item>
        <item name="android:windowLightStatusBar">@bool/barra_clara</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/barra_clara</item>
        <item name="materialButtonStyle">@style/Widget.Rutina.Boton</item>
        <item name="editTextStyle">@style/Widget.Rutina.Campo</item>
    </style>

    <!-- Botón plano: borde fino, esquinas casi rectas, sin sombra ni mayúsculas -->
    <style name="Widget.Rutina.Boton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">3dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/borde</item>
        <item name="backgroundTint">@color/barra</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">@color/borde</item>
    </style>

    <!-- Campo de texto: fondo claro/oscuro, borde de 1 dp y azul con foco -->
    <style name="Widget.Rutina.Campo" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/fondo_campo</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">@color/secundario</item>
        <item name="android:padding">8dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <!-- Desplegable con el mismo borde -->
    <style name="Widget.Rutina.Desplegable" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/fondo_campo</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <!-- Texto de la barra superior -->
    <style name="Rutina.TituloBarra" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
